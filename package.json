{
  "name": "clickfit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:sw && next dev",
    "build": "npm run build:sw && next build",
    "build:sw": "esbuild src/sw/sw.ts --bundle --format=iife --minify --target=es2022 --outfile=public/sw.js",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:staging": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env staging",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply clickfit --local",
    "db:migrate:staging": "wrangler d1 migrations apply clickfit-staging --remote --env staging",
    "db:migrate:prod": "wrangler d1 migrations apply clickfit --remote",
    "db:seed": "tsx scripts/seed.ts",
    "db:backup": "wrangler d1 export clickfit --remote --output=backups/clickfit-$(date +%Y%m%d-%H%M%S).sql",
    "icons": "tsx scripts/generate-icons.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:size": "tsx scripts/check-file-size.ts",
    "check": "npm run typecheck && npm run lint && npm run check:size && npm run test"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "better-auth": "^1.7.23",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@opennextjs/cloudflare": "^1.20.17",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-i18next": "^6.1.5",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261113.1": true,
    "@swc/core@1.16.22": true,
    "@parcel/watcher": false,
    "fsevents": false
  }
}
