{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clickfit",
  // Eigener Einstieg: reicht Anfragen an OpenNext weiter und verarbeitet zusätzlich die Queue.
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Ohne dies hängt esbuild `__name(...)` an Funktionen. Das bricht Inline-Skripte, die per
  // toString() in die Seite geschrieben werden (Theme-Skript von next-themes).
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "workers_dev": false,
  "routes": [
    { "pattern": "clickfit.online", "custom_domain": true },
    { "pattern": "www.clickfit.online", "custom_domain": true }
  ],
  "vars": {
    "APP_URL": "https://clickfit.online",
    // Öffentlicher Schlüssel für Web Push. Der private liegt als Secret VAPID_PRIVATE_KEY vor.
    "VAPID_PUBLIC_KEY": "BLsjzLNKQxia_Hj6yAbwq8y9GoJUkEe_uXi-ld1Tj4WQtfa9u8YpTYoT1whEk0qwv9QNBg07042n5T8-UZRfnHQ"
  },
  "queues": {
    // Zeitversetzte Nachrichten für die Benachrichtigung am Ende der Pause.
    "producers": [{ "binding": "REST_TIMER_QUEUE", "queue": "clickfit-rest-timer" }],
    "consumers": [
      { "queue": "clickfit-rest-timer", "max_batch_size": 10, "max_batch_timeout": 0, "max_retries": 2 }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clickfit",
      "database_id": "9d873abe-e148-461f-b8bf-076c5337d30a",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "r2_buckets": [
    {
      // Privater Bucket für Fortschrittsfotos und andere Uploads (ab Phase 4 genutzt)
      "binding": "UPLOADS",
      "bucket_name": "clickfit-uploads",
      "jurisdiction": "eu"
    }
  ],
  "env": {
    "staging": {
      "name": "clickfit-staging",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "APP_URL": "https://clickfit-staging.<your-subdomain>.workers.dev",
        "VAPID_PUBLIC_KEY": "BLsjzLNKQxia_Hj6yAbwq8y9GoJUkEe_uXi-ld1Tj4WQtfa9u8YpTYoT1whEk0qwv9QNBg07042n5T8-UZRfnHQ"
      },
      "queues": {
        "producers": [{ "binding": "REST_TIMER_QUEUE", "queue": "clickfit-rest-timer-staging" }],
        "consumers": [
          { "queue": "clickfit-rest-timer-staging", "max_batch_size": 10, "max_batch_timeout": 0, "max_retries": 2 }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "clickfit-staging",
          // Durch die ID ersetzen, die `wrangler d1 create clickfit-staging --location weur` ausgibt
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "drizzle/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "UPLOADS",
          "bucket_name": "clickfit-uploads-staging",
          "jurisdiction": "eu"
        }
      ]
    }
  }
}
