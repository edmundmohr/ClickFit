{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clickfit",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Ohne dies hängt esbuild `__name(...)` an Funktionen. Das bricht Inline-Skripte, die per
  // toString() in die Seite geschrieben werden (Theme-Skript von next-themes).
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "workers_dev": false,
  "routes": [
    { "pattern": "clickfit.online", "custom_domain": true },
    { "pattern": "www.clickfit.online", "custom_domain": true }
  ],
  "vars": {
    "APP_URL": "https://clickfit.online"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clickfit",
      // Durch die ID ersetzen, die `wrangler d1 create clickfit --location weur` ausgibt
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "r2_buckets": [
    {
      // Privater Bucket für Fortschrittsfotos und andere Uploads (ab Phase 4 genutzt)
      "binding": "UPLOADS",
      "bucket_name": "clickfit-uploads",
      "jurisdiction": "eu"
    }
  ],
  "env": {
    "staging": {
      "name": "clickfit-staging",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "APP_URL": "https://clickfit-staging.<your-subdomain>.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "clickfit-staging",
          // Durch die ID ersetzen, die `wrangler d1 create clickfit-staging --location weur` ausgibt
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "drizzle/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "UPLOADS",
          "bucket_name": "clickfit-uploads-staging",
          "jurisdiction": "eu"
        }
      ]
    }
  }
}
