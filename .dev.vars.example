# Lokale Secrets für `next dev` / `wrangler`. Nach `.dev.vars` kopieren.
# Für Staging/Produktion mit `wrangler secret put <NAME> [--env staging]` setzen.

# Zufälliger String, mindestens 32 Zeichen (z. B. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Öffentliche Basis-URL der App (überschreibt den Wert aus wrangler.jsonc)
APP_URL=http://localhost:3000
