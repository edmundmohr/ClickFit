{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "clickfit-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "clickfit-worker-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "opennextjs-cloudflare",
        "preview",
        "--port",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "clickfit-worker-preview-3100",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--port",
        "3100",
        "--local-upstream",
        "localhost:3100",
        "--var",
        "APP_URL:http://localhost:3100"
      ],
      "port": 3100
    }
  ]
}
